# URL del backend Spring Boot (vacío en Fase 1 — GitHub Pages)
# En Fase 2: https://api.fundacionmujeressintechodecristal.org
VITE_API_URL=

# Número de WhatsApp de la fundación (formato internacional sin +)
VITE_WHATSAPP_NUMBER=573188307155

# Endpoint del formulario de contacto
# Fase 1: Formspree (https://formspree.io/f/YOUR_FORM_ID)
# Fase 2: /api/v1/contact
VITE_FORM_ENDPOINT=https://formspree.io/f/YOUR_FORM_ID

# Entorno
VITE_APP_ENV=development
