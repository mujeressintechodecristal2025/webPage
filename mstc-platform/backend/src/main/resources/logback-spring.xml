<?xml version="1.0" encoding="UTF-8"?>
<!--
  ══════════════════════════════════════════════════════════════════════════════
  Logback Configuration — MSTC Platform Backend
  - Perfil dev:  consola legible con colores
  - Perfil prod: JSON estructurado a stdout (CloudWatch Agent lo captura)
                 + archivo rotado en /var/log/mstc/ como respaldo
  ══════════════════════════════════════════════════════════════════════════════
-->
<configuration scan="true" scanPeriod="30 seconds">

    <!-- ── Propiedades comunes ──────────────────────────────────────────────── -->
    <property name="APP_NAME" value="mstc-backend"/>
    <property name="LOG_DIR" value="/var/log/mstc"/>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- PERFIL: dev — Consola legible con colores                            -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <springProfile name="dev,local,test">
        <appender name="CONSOLE_DEV" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>
                    %d{HH:mm:ss.SSS} %highlight(%-5level) [%thread] %cyan(%-40.40logger{39}) : %msg%n%throwable
                </pattern>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE_DEV"/>
        </root>

        <logger name="org.mstc" level="DEBUG"/>
        <logger name="org.springframework.security" level="DEBUG"/>
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.flywaydb" level="INFO"/>
    </springProfile>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- PERFIL: prod — JSON estructurado a stdout + archivo rotado           -->
    <!-- CloudWatch Agent lee stdout del contenedor Docker (json-file driver) -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <springProfile name="prod">

        <!-- ── Stdout JSON (capturado por Docker → CloudWatch Agent) ───────── -->
        <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>requestId</includeMdcKeyName>
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>clientIp</includeMdcKeyName>
                <includeMdcKeyName>httpMethod</includeMdcKeyName>
                <includeMdcKeyName>requestPath</includeMdcKeyName>
                <includeMdcKeyName>userId</includeMdcKeyName>
                <fieldNames>
                    <timestamp>timestamp</timestamp>
                    <version>[ignore]</version>
                </fieldNames>
                <timeZone>UTC</timeZone>
                <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
                <!-- Campos personalizados fijos -->
                <customFields>{"service":"mstc-backend","env":"prod"}</customFields>
            </encoder>
        </appender>

        <!-- ── Archivo rotado como respaldo local ──────────────────────────── -->
        <appender name="FILE_JSON" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/application.json</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/application.%d{yyyy-MM-dd}.%i.json.gz</fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <maxHistory>7</maxHistory>
                <totalSizeCap>100MB</totalSizeCap>
            </rollingPolicy>
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>requestId</includeMdcKeyName>
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <includeMdcKeyName>clientIp</includeMdcKeyName>
                <includeMdcKeyName>httpMethod</includeMdcKeyName>
                <includeMdcKeyName>requestPath</includeMdcKeyName>
                <includeMdcKeyName>userId</includeMdcKeyName>
                <fieldNames>
                    <timestamp>timestamp</timestamp>
                    <version>[ignore]</version>
                </fieldNames>
                <timeZone>UTC</timeZone>
                <shortenedLoggerNameLength>36</shortenedLoggerNameLength>
                <customFields>{"service":"mstc-backend","env":"prod"}</customFields>
            </encoder>
        </appender>

        <root level="INFO">
            <appender-ref ref="CONSOLE_JSON"/>
            <appender-ref ref="FILE_JSON"/>
        </root>

        <logger name="org.mstc" level="INFO"/>
        <logger name="org.springframework.security" level="WARN"/>
        <logger name="org.hibernate.SQL" level="WARN"/>
        <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="WARN"/>
        <logger name="org.apache.catalina" level="WARN"/>
        <logger name="org.apache.tomcat" level="WARN"/>
    </springProfile>

</configuration>
